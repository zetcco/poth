<?xml version="1.0" encoding="utf-8"?>
<!-- The reading widget on a dark home screen: the same hue, brightening with more reading, from
     tone 40 (tone 30 was too close to the background to see). -->
<resources>
    <color name="widget_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_surface">@android:color/system_neutral1_50</color>
    <color name="widget_on_surface_variant">@android:color/system_neutral2_200</color>
    <color name="widget_heat_0">@android:color/system_neutral2_800</color>
    <color name="widget_heat_1">@android:color/system_accent1_600</color>
    <color name="widget_heat_2">@android:color/system_accent1_400</color>
    <color name="widget_heat_3">@android:color/system_accent1_200</color>
    <color name="widget_heat_4">@android:color/system_accent1_50</color>
</resources>
